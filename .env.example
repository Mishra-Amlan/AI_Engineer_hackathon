# ============================================================
# The Unreliable Assistant — environment config (DEV / low-cost)
# NEVER commit this file. Real secrets go ONLY in .env.
# ============================================================

# ---- OpenRouter ------------------------------------------------
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Optional attribution headers OpenRouter recommends
OPENROUTER_APP_TITLE=unreliable-assistant-dev
OPENROUTER_APP_URL=http://localhost:8000

# ---- Model Router tiers (see CLAUDE.md §9) ---------------------
# Cheap models for now. Upgrade later by changing ONLY these lines.
# Slugs are OpenRouter model IDs — verify availability/price at https://openrouter.ai/models
# T1: small/fast (triage, classification, arg extraction, query rewrite)
MODEL_T1_PRIMARY=anthropic/claude-haiku-5.5
MODEL_T1_FALLBACK=anthropic/claude-haiku-4.5
# T2: default grounded generation
MODEL_T2_PRIMARY=anthropic/claude-haiku-5.5
MODEL_T2_FALLBACK=anthropic/claude-haiku-4.5
# T3: complex reasoning / verification-veto retry (kept cheap for now; upgrade later)
MODEL_T3_PRIMARY=anthropic/claude-haiku-5.5
MODEL_T3_FALLBACK=anthropic/claude-haiku-4.5
# Verification / NLI claim checker (independent model from generator)
MODEL_VERIFIER=anthropic/claude-haiku-4.5

# ---- Generation defaults ---------------------------------------
TRIAGE_TEMPERATURE=0.0
GENERATION_TEMPERATURE=0.1
MAX_OUTPUT_TOKENS=512

# ---- Router fallback & resilience ------------------------------
ROUTER_MAX_RETRIES=1
ROUTER_RETRY_BACKOFF_MS=50
ROUTER_REQUEST_TIMEOUT_MS=8000
ROUTER_BREAKER_FAILURE_THRESHOLD=2
ROUTER_BREAKER_COOLDOWN_S=30
ROUTER_ESCALATE_MAX=1

# ---- Cost guardrails (dev) -------------------------------------
# Hard stop so a runaway loop can't burn credits.
DAILY_BUDGET_USD=2.00
PER_TENANT_DAILY_BUDGET_USD=0.50
PER_REQUEST_MAX_TOKENS=4000
# Also set a credit limit on the key in the OpenRouter dashboard.

# ---- Retrieval (local, no API cost) ----------------------------
EMBEDDING_MODEL=BAAI/bge-large-en-v1.5
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
BM25_K1=1.25
BM25_B=0.75
RRF_K=60
RERANK_THRESHOLD=0.42
RERANK_TOP_K=4

# ---- Agent loop limits (Gate 4) --------------------------------
REACT_MAX_ITERATIONS=5
REACT_PER_STEP_TIMEOUT_MS=120
REACT_TOTAL_BUDGET_MS=450

# ---- Infrastructure (local dev) --------------------------------
APP_ENV=dev
REDIS_URL=redis://localhost:6379/0
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/assistant
MCP_STATE_STORE_URL=http://localhost:8081/mcp
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
CACHE_TTL_SECONDS=300
CACHE_TTL_JITTER_SECONDS=45

# ---- Security ---------------------------------------------------
# Generate with: openssl rand -hex 32
JWT_SECRET=
AUDIT_HASH_SEED=

# ---- Groq (OpenAI-compatible; used for gpt-oss-120b) ----
GROQ_API_KEY=
GROQ_BASE_URL=https://api.groq.com/openai/v1
